@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">

                <span class="badge bg-success px-3 py-2 mb-3">
                    🌱 Fresh from Barangay Maloray
                </span>

                <h1 class="display-4 fw-bold">
                    Fresh Vegetables <br />
                    Direct from Local Farmers
                </h1>

                <p class="lead mt-4">
                    FarmLink connects vegetable farmers in Barangay Maloray
                    with customers across Cebu City. Enjoy fresh, affordable,
                    and locally grown vegetables delivered with care.
                </p>

                <div class="mt-4">
                    <a href="#" class="btn btn-success btn-lg me-3">
                        Shop Now
                    </a>

                    <a href="#" class="btn btn-outline-success btn-lg">
                        Become a Farmer
                    </a>
                </div>

            </div>

            <div class="col-lg-6 text-center">

                <img src="~/images/hero/hero.jpg"
                     class="img-fluid hero-image"
                     alt="FarmLink">

            </div>

        </div>
    </div>
</section>
<!-- Featured Products -->
<section class="py-5 bg-light">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">Featured Vegetables</h2>
            <p class="text-muted">
                Freshly harvested vegetables from the farmers of Barangay Maloray.
            </p>
        </div>

        <div class="row g-4">

            <!-- Pechay -->
            <div class="col-md-4 col-lg-3">
                <div class="card product-card h-100">
                    <img src="~/images/vegetables/pechay.jpeg" class="card-img-top" alt="Pechay">
                    <div class="card-body text-center">
                        <h5>Pechay</h5>
                        <p class="text-success fw-bold">₱45 / kg</p>
                        <button class="btn btn-success w-100">View Product</button>
                    </div>
                </div>
            </div>

            <!-- Tomato -->
            <div class="col-md-4 col-lg-3">
                <div class="card product-card h-100">
                    <img src="~/images/vegetables/tomato.jpg" class="card-img-top" alt="Tomato">
                    <div class="card-body text-center">
                        <h5>Tomato</h5>
                        <p class="text-success fw-bold">₱60 / kg</p>
                        <button class="btn btn-success w-100">View Product</button>
                    </div>
                </div>
            </div>

            <!-- Eggplant -->
            <div class="col-md-4 col-lg-3">
                <div class="card product-card h-100">
                    <img src="~/images/vegetables/eggplant.jpg" class="card-img-top" alt="Eggplant">
                    <div class="card-body text-center">
                        <h5>Eggplant</h5>
                        <p class="text-success fw-bold">₱55 / kg</p>
                        <button class="btn btn-success w-100">View Product</button>
                    </div>
                </div>
            </div>

            <!-- Okra -->
            <div class="col-md-4 col-lg-3">
                <div class="card product-card h-100">
                    <img src="~/images/vegetables/okra.jpg" class="card-img-top" alt="Okra">
                    <div class="card-body text-center">
                        <h5>Okra</h5>
                        <p class="text-success fw-bold">₱50 / kg</p>
                        <button class="btn btn-success w-100">View Product</button>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>
<!-- Why Choose FarmLink -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">Why Choose FarmLink?</h2>
            <p class="text-muted">
                We connect local farmers in Barangay Maloray with customers in Cebu City.
            </p>
        </div>

        <div class="row text-center">

            <div class="col-md-3 mb-4">
                <div class="p-4 shadow-sm rounded bg-white h-100">
                    <div class="display-4 mb-3">🥬</div>
                    <h5>Fresh Harvest</h5>
                    <p class="text-muted">
                        Vegetables harvested fresh from local farms.
                    </p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="p-4 shadow-sm rounded bg-white h-100">
                    <div class="display-4 mb-3">🚚</div>
                    <h5>Fast Delivery</h5>
                    <p class="text-muted">
                        Delivering fresh vegetables to customers in Cebu City.
                    </p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="p-4 shadow-sm rounded bg-white h-100">
                    <div class="display-4 mb-3">👨‍🌾</div>
                    <h5>Support Farmers</h5>
                    <p class="text-muted">
                        Buy directly from farmers and help the local community.
                    </p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="p-4 shadow-sm rounded bg-white h-100">
                    <div class="display-4 mb-3">💰</div>
                    <h5>Affordable Prices</h5>
                    <p class="text-muted">
                        Fair prices without unnecessary middlemen.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>
<!-- About FarmLink -->
<section class="py-5 bg-success text-white">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <img src="~/images/hero/hero.jpg"
                     class="img-fluid rounded shadow"
                     alt="About FarmLink">
            </div>

            <div class="col-lg-6">

                <h2 class="fw-bold mb-4">
                    About FarmLink
                </h2>

                <p class="lead">
                    FarmLink is a community-based online marketplace that connects
                    vegetable farmers from Barangay Maloray with customers across
                    Cebu City.
                </p>

                <p>
                    Our mission is to help local farmers sell their harvest directly,
                    ensuring fair prices while providing customers with fresh,
                    healthy, and affordable vegetables.
                </p>

                <a href="#" class="btn btn-warning btn-lg mt-3">
                    Learn More
                </a>

            </div>

        </div>
    </div>
</section>
<!-- How It Works -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">How FarmLink Works</h2>
            <p class="text-muted">
                Buying fresh vegetables is easy.
            </p>
        </div>

        <div class="row text-center">

            <div class="col-md-3">
                <div class="p-4">
                    <div class="display-4">👨‍🌾</div>
                    <h5 class="mt-3">1. Farmers Post Products</h5>
                    <p>Farmers upload their available vegetables.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4">
                    <div class="display-4">🛒</div>
                    <h5 class="mt-3">2. Customers Order</h5>
                    <p>Customers browse and place orders online.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4">
                    <div class="display-4">✅</div>
                    <h5 class="mt-3">3. Farmer Confirms</h5>
                    <p>The farmer prepares and confirms the order.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4">
                    <div class="display-4">🚚</div>
                    <h5 class="mt-3">4. Delivery</h5>
                    <p>Fresh vegetables are delivered to the customer.</p>
                </div>
            </div>

        </div>

    </div>
</section>