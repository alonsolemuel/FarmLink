@model FarmLink.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="text-center">Create an Account</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    @if (Model != null)
                    {
                        if (Model.Role == "Farmer")
                        {
                            <div class="alert alert-success text-center">
                                🌾 You are creating a <strong>Farmer Account</strong>
                            </div>
                        }
                        else if (Model.Role == "Customer")
                        {
                            <div class="alert alert-warning text-center">
                                🛒 You are creating a <strong>Customer Account</strong>
                            </div>
                        }
                    }
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    <form asp-action="Register" asp-controller="Account" method="post">

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <textarea asp-for="Address" class="form-control"></textarea>
                        </div>

                        <input asp-for="Role" type="hidden" />

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control" />
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Register
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}