@model FarmLink.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-5">

    <div class="row">

        <div class="col-md-6">

            <img src="~/images/products/@Model.ImagePath"
                 class="img-fluid rounded shadow">

        </div>

        <div class="col-md-6">

            <span class="badge bg-success mb-3">
                @Model.Category
            </span>

            <h1 class="fw-bold">
                @Model.ProductName
            </h1>

            <p class="text-muted">
                @Model.Description
            </p>

            <h2 class="text-success fw-bold">
                ₱@Model.Price.ToString("N2") / @Model.Unit
            </h2>

            <hr />

            <p>
                📦 <strong>Available:</strong>
                @Model.Quantity @Model.Unit
            </p>

            <p>
                👨‍🌾 <strong>Farmer:</strong>
                @Model.Farmer.FullName
            </p>

            <p>
                📍 <strong>Location:</strong>
                @Model.Farmer.Address
            </p>

            <div class="d-grid gap-2 mt-4">

                <button class="btn btn-success btn-lg">
                    🛒 Add to Cart
                </button>

                <button class="btn btn-outline-primary btn-lg">
                    💬 Chat Farmer
                </button>

            </div>

            <a asp-action="Index"
               class="btn btn-link mt-3">
                ← Back to Marketplace
            </a>

        </div>

    </div>

</div>