@model FarmLink.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header bg-success text-white">
                    <h3>Edit Product</h3>
                </div>

                <div class="card-body">

                    <<form asp-action="Edit"
                           asp-route-id="@ViewBag.ProductId"
                           method="post"
                           enctype="multipart/form-data">

                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label"></label>
                            <input asp-for="ProductName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <input asp-for="Category" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label"></label>

                            <input asp-for="Quantity"
                                   class="form-control" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Unit" class="form-label"></label>

                            <select asp-for="Unit" class="form-select">

                                <option value="">Select Unit</option>

                                <option>kg</option>
                                <option>g</option>
                                <option>Bundle</option>
                                <option>Piece</option>
                                <option>Sack</option>
                                <option>Crate</option>
                                <option>Basket</option>

                            </select>

                            <span asp-validation-for="Unit"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label">
                                Product Image
                            </label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <span asp-validation-for="ImageFile"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            Save Product
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}